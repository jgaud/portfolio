---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects"> | CollectionEntry<"publications">;
};

const { entry } = Astro.props as {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects"> | CollectionEntry<"publications">;
};
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class="not-prose group relative flex flex-nowrap rounded-xl border border-neutral-200/80 bg-white/50 px-5 py-4 pr-12 shadow-sm transition-all duration-300 ease-in-out hover:border-accent-300/50 hover:bg-white hover:shadow-md hover:shadow-accent-500/5 focus-visible:border-accent-300/50 focus-visible:bg-white focus-visible:shadow-md dark:border-white/[0.08] dark:bg-white/[0.02] dark:hover:border-accent-400/20 dark:hover:bg-white/[0.05] dark:hover:shadow-accent-400/5 dark:focus-visible:border-accent-400/20 dark:focus-visible:bg-white/[0.05]"
>
  <div class="flex flex-1 flex-col">
    <div class="font-semibold text-neutral-900 dark:text-white">
      {entry.data.title}
    </div>
    <div class="text-sm text-neutral-500 dark:text-neutral-400">
      {entry.data.description}
    </div>
    {entry.collection === "publications" && (
      <div class="mt-1 text-xs text-neutral-400 dark:text-neutral-500">
        <FormattedDate date={entry.data.date} />
      </div>
    )}
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute right-3 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2 text-neutral-400 transition-all duration-300 ease-in-out group-hover:text-accent-500 group-focus-visible:text-accent-500 dark:text-neutral-500 dark:group-hover:text-accent-400 dark:group-focus-visible:text-accent-400"
  >
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
    ></line>
    <polyline
      points="12 5 19 12 12 19"
      class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
    ></polyline>
  </svg>
</a>
