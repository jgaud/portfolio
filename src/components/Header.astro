---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header transition:persist>
  <Container>
    <div class="flex flex-wrap items-center justify-between gap-y-2">
      <Link href="/" underline={false}>
        <div class="font-semibold text-neutral-900 dark:text-white tracking-tight">
          {SITE.TITLE}
        </div>
      </Link>
      <nav class="flex items-center gap-1.5 text-sm">
        <Link href="/blog">blog</Link>
        <span class="text-neutral-300 dark:text-neutral-600">
          {`/`}
        </span>
        <Link href="/projects">projects</Link>
        <span class="text-neutral-300 dark:text-neutral-600">
          {`/`}
        </span>
        <button
          id="magnifying-glass"
          aria-label="Search"
          class="flex items-center gap-1.5 rounded-lg border border-neutral-200/80 bg-white/60 px-2.5 py-1.5 text-xs text-neutral-500 transition-all duration-300 ease-in-out hover:border-accent-300/50 hover:bg-white hover:text-accent-600 focus-visible:border-accent-300/50 focus-visible:bg-white focus-visible:text-accent-600 dark:border-white/[0.08] dark:bg-white/[0.03] dark:text-neutral-400 dark:hover:border-accent-400/20 dark:hover:bg-white/[0.06] dark:hover:text-accent-400 dark:focus-visible:border-accent-400/20 dark:focus-visible:bg-white/[0.06] dark:focus-visible:text-accent-400"
        >
          <svg
            height="14"
            stroke-linejoin="round"
            viewBox="0 0 16 16"
            width="14"
            style="color: currentcolor;"
            ><path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z"
              fill="currentColor"></path></svg
          >
          Search
        </button>
      </nav>
    </div>
  </Container>
</header>
