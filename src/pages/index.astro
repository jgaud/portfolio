---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS, PUBLICATIONS } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const publications: CollectionEntry<"publications">[] = (
  await getCollection("publications")
)
  .filter((pub) => !pub.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PUBLICATIONS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-16">
        <!-- Hero Section -->
        <section class="animate space-y-4">
          <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-6">
            <div class="space-y-4 flex-1">
              <div class="space-y-2">
                <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-4xl">
                  Hi, I'm <Link href="#connect"><span class="gradient-text">Jean-Gabriel</span></Link>
                </h1>
                <p class="text-lg text-neutral-500 dark:text-neutral-400">
                  PhD &mdash; Machine Learning, Software Development & Education
                </p>
              </div>
              <div class="h-px w-16 bg-gradient-to-r from-accent-500 to-accent-300"></div>
              <article class="space-y-4">
                <p>
                  Welcome to my personal website. I {blog.length > 0 ? <><Link href="/blog">write</Link> about</> : <>write about</>}
                  things that interest me, 
                  mostly machine learning, software development, and education. 
                  I share insights from my research and projects, along with other stuff I find interesting.
                </p>
              </article>
            </div>
            <div class="shrink-0">
              <img
                src="/profile.jpg"
                alt="Jean-Gabriel Gaudreault"
                class="profile-photo w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover ring-2 ring-accent-400/30 dark:ring-accent-400/20 shadow-lg"
              />
            </div>
          </div>
        </section>

        <section id="connect" class="animate space-y-4">
          <h2 class="section-heading font-semibold text-neutral-900 dark:text-white">
            Let's Connect
          </h2>
          <article>
            <p>
              If you want to get in touch with me about something or just to say
              hi, reach out on social media or send me an email.
            </p>
          </article>
          <ul class="not-prose flex flex-wrap gap-2">
            {
              SOCIALS.map((SOCIAL) => (
                <li class="flex gap-x-2 text-nowrap">
                  <Link
                    href={SOCIAL.HREF}
                    external
                    aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
                  >
                    {SOCIAL.NAME}
                  </Link>
                  {"/"}
                </li>
              ))
            }
            <li class="line-clamp-1">
              <Link
                href={`mailto:${SITE.EMAIL}`}
                aria-label={`Email ${SITE.TITLE}`}
              >
                {SITE.EMAIL}
              </Link>
            </li>
          </ul>
        </section>

        {blog.length > 0 && (
          <section class="animate space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-y-2">
              <h2 class="section-heading font-semibold text-neutral-900 dark:text-white">
                Latest posts
              </h2>
              <Link href="/blog"> See all posts </Link>
            </div>
            <ul class="not-prose flex flex-col gap-4">
              {
                blog.map((post) => (
                  <li>
                    <ArrowCard entry={post} />
                  </li>
                ))
              }
            </ul>
          </section>
        )}

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="section-heading font-semibold text-neutral-900 dark:text-white">
              Recent projects
            </h2>
            <Link href="/projects"> See all projects </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              projects.map((project) => (
                <li>
                  <ArrowCard entry={project} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="section-heading font-semibold text-neutral-900 dark:text-white">
              Recent publications
            </h2>
            <Link href="/publications"> See all publications </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              publications.map((pub) => (
                <li>
                  <ArrowCard entry={pub} />
                </li>
              ))
            }
          </ul>
        </section>     
      </div>
    </aside>
  </Container>
</Layout>
