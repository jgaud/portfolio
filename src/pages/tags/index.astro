---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
---

<Layout title="Tags" description="List of tags used.">
  <Container>
    <div class="space-y-10">
      <h1 class="animate section-heading font-semibold text-neutral-900 dark:text-white">All Tags</h1>
      <div class="animate flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="rounded-lg border border-neutral-200/80 bg-white/50 px-3 py-1.5 text-sm transition-all duration-300 ease-in-out hover:border-accent-300/50 hover:bg-white hover:text-accent-600 focus-visible:border-accent-300/50 focus-visible:bg-white focus-visible:text-accent-600 dark:border-white/[0.08] dark:bg-white/[0.02] dark:hover:border-accent-400/20 dark:hover:bg-white/[0.05] dark:hover:text-accent-400 dark:focus-visible:border-accent-400/20 dark:focus-visible:bg-white/[0.05] dark:focus-visible:text-accent-400"
            >
              {tag}{" "}
              <span class="text-sm text-neutral-400 dark:text-neutral-500">
                ({posts.filter((post) => post.data.tags?.includes(tag)).length})
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>
